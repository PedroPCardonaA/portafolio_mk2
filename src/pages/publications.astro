---
import Base from '../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const publications = (await getCollection('publications'))
  .sort((a: CollectionEntry<'publications'>, b: CollectionEntry<'publications'>) => b.data.year - a.data.year);
---

<Base title="Publications — Pedro Cardona" description="Papers and publications by Pedro Cardona." path="/publications">
  <section class="page">
    <p class="cap">Publications</p>
    <h1>Publications</h1>

    {publications.length === 0 ? (
      <div class="empty">
        <p class="cap">status</p>
        <p class="msg">First publication coming soon.</p>
        <p class="sub">This page will list papers, preprints and theses as they're published — check back later.</p>
      </div>
    ) : (
      <ul class="list">
        {publications.map((p: CollectionEntry<'publications'>) => (
          <li>
            <p class="title">{p.data.title}</p>
            <p class="meta mono">{p.data.authors.join(', ')} · {p.data.venue} · {p.data.year}</p>
            <div class="links">
              {p.data.doi && <a class="acc" href={p.data.doi}>DOI ↗</a>}
              {p.data.pdf && <a class="acc" href={p.data.pdf}>PDF ↗</a>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .page { padding: var(--s-8); display: flex; flex-direction: column; gap: var(--s-4); max-width: var(--measure); }
  .empty {
    margin-top: var(--s-4);
    border: 1px dashed var(--line-2);
    padding: var(--s-6) var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .msg { font: 600 18px var(--font-head); text-transform: uppercase; letter-spacing: .03em; color: var(--acc); }
  .sub { color: var(--text-dim); font-size: 13.5px; margin: 0; }
  .list { display: flex; flex-direction: column; margin-top: var(--s-4); }
  .list li { border-top: 1px solid var(--line); padding: var(--s-3) 0; display: flex; flex-direction: column; gap: 4px; }
  .list li:last-child { border-bottom: 1px solid var(--line); }
  .title { font: 600 16px var(--font-head); text-transform: uppercase; letter-spacing: .02em; }
  .meta { color: var(--text-dim); font-size: 12px; }
  .links { display: flex; gap: var(--s-3); }
  .acc { color: var(--acc); font: 400 12px var(--font-mono); }
</style>
