---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('now', 'now');
if (!entry) throw new Error('Missing src/content/now/now.md entry');

const { Content } = await render(entry);
const updated = entry.data.updated.toISOString().slice(0, 7).replace('-', '.');

const setup = [
  ['editor', 'TODO'],
  ['machine', 'TODO'],
  ['shell', 'TODO'],
  ['langs', 'TODO'],
];
---

<Base title="Now — Pedro Cardona" description="What Pedro Cardona is up to now." path="/now">
  <section class="page">
    <p class="cap">Updated {updated}</p>
    <h1>Now</h1>
    <div class="prose-body"><Content /></div>

    <p class="cap">Setup</p>
    <div class="grid">
      {setup.map(([label, value]) => (
        <div class="cell mono"><span class="label">{label} —</span> {value}</div>
      ))}
    </div>
  </section>
</Base>

<style>
  .page { padding: var(--s-8); display: flex; flex-direction: column; gap: var(--s-4); max-width: var(--measure); }
  .prose-body :global(p) { color: var(--text-dim); font-size: 14.5px; }
  .prose-body :global(ul) { list-style: disc; padding-left: 1.4em; display: flex; flex-direction: column; gap: 4px; color: var(--text-dim); font-size: 14.5px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
  .cell { border: 1px solid var(--line-2); padding: var(--s-3); color: var(--text-dim); }
  .label { color: var(--text-mute); }
</style>
