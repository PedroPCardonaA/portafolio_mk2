---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="rows">
  {projects.map((p, i) => (
    <li>
      <a href={`/projects/${p.id}`} data-i={i} aria-describedby="preview">
        <span class="title">{p.data.title}</span>
        <span class="year mono">{p.data.year}</span>
      </a>
      <p class="summary-mobile">{p.data.summary}</p>
    </li>
  ))}
</ul>

<style>
  .rows { flex: 1; display: flex; flex-direction: column; }
  li { border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-5);
  }
  .title { font: 600 20px/1.1 var(--font-head); text-transform: uppercase; letter-spacing: .03em; color: var(--text); }
  a:hover .title, a:focus-visible .title { color: var(--acc); }
  .year { color: var(--text-dim); font-size: 12px; }
  .summary-mobile { display: none; margin: 0 var(--s-5) var(--s-4); color: var(--text-dim); font-size: 13.5px; }

  @media (max-width: 860px) {
    .summary-mobile { display: block; }
  }
</style>
