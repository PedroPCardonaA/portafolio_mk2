---
interface Props {
  status?: string;
  message: string;
  sub?: string;
}

const { status = 'status', message, sub } = Astro.props;
---

<div class="empty">
  <p class="cap">{status}</p>
  <p class="msg">{message}</p>
  {sub && <p class="sub">{sub}</p>}
</div>

<style>
  .empty {
    margin-top: var(--s-4);
    border: 1px dashed var(--line-2);
    padding: var(--s-6) var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .msg { font: 600 18px var(--font-head); text-transform: uppercase; letter-spacing: .03em; color: var(--acc); }
  .sub { color: var(--text-dim); font-size: 13.5px; margin: 0; }
</style>
