---
interface Props {
  path: string;
}

const nav: [string, string, string | null][] = [
  ['01', 'Home', '/'],
  ['02', 'Work', '/#work'],
  ['03', 'Publications', '/#publications'],
  ['04', 'CV', null],
  ['05', 'Posts', '/#posts'],
  ['06', 'About', '/#about'],
  ['07', 'Now / Uses', '/#now'],
];
const contact: [string, string, string] = ['08', 'Contact', '/#contact'];

const { path } = Astro.props;
// Detail pages (/projects/*, /posts/*) aren't sections of the one-pager, so fall back to
// highlighting the section they belong under. On "/" itself, a client-side scroll-spy
// (below) takes over and drives the .active class as the user scrolls.
const active = (href: string | null) => {
  if (!href) return false;
  if (href === '/') return path === '/';
  if (path.startsWith('/projects')) return href === '/#work';
  if (path.startsWith('/posts')) return href === '/#posts';
  return false;
};
---

<nav aria-label="Primary" class="rail">
  <a class="brand" href="/">P. Cardona</a>
  <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />
  <label for="nav-toggle" class="toggle" aria-label="Toggle navigation">
    <span aria-hidden="true">☰</span>
  </label>
  <div class="body">
    <ul>
      {nav.map(([n, label, href]) => (
        <li>
          {href ? (
            <a href={href} aria-current={active(href) ? 'page' : undefined} class:list={[{ active: active(href) }]}>
              <span class="num">{n}</span>{label}
            </a>
          ) : (
            <span class="disabled" aria-disabled="true">
              <span class="num">{n}</span>{label}
            </span>
          )}
        </li>
      ))}
    </ul>
    <a class="foot" href={contact[2]} aria-current={active(contact[2]) ? 'page' : undefined}>
      <span class="num">{contact[0]}</span>{contact[1]}
    </a>
    <span class="cap locale">EN · ES</span>
  </div>
</nav>

<style>
  .rail {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--rail);
    background: var(--surface);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    z-index: 10;
  }
  .brand {
    display: block;
    padding: var(--s-4) var(--s-3);
    font: 600 13px/1 var(--font-head);
    letter-spacing: .14em;
    color: var(--acc);
  }
  .nav-toggle-checkbox { position: absolute; opacity: 0; pointer-events: none; }
  .toggle { display: none; }
  .body { flex: 1; display: flex; flex-direction: column; min-height: 0; padding: 0 var(--s-3) var(--s-4); gap: var(--s-2); }
  ul { display: flex; flex-direction: column; gap: var(--s-1); }
  .body a, .disabled {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    font: 400 11px/1.4 var(--font-mono);
    color: var(--text-dim);
    padding: var(--s-2) var(--s-2);
    margin: 0 calc(var(--s-2) * -1);
    border-left: 2px solid transparent;
  }
  .body a:hover { color: var(--acc); background: var(--acc-wash); }
  .body a.active { color: var(--acc); background: var(--acc-wash); border-left-color: var(--acc); }
  .disabled { color: var(--text-mute); }
  .num { color: var(--text-mute); }
  .body a.active .num, .body a:hover .num { color: var(--acc); }
  .foot { margin-top: auto; }
  .locale { margin-top: var(--s-2); }

  @media (max-width: 860px) {
    .rail { inset: 0 0 auto 0; width: 100%; height: 48px; flex-direction: row; align-items: center; border-right: 0; border-bottom: 1px solid var(--line); }
    .brand { padding: 0 var(--s-3); }
    .toggle { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; margin-left: auto; cursor: pointer; font-size: 18px; color: var(--text-dim); }
    .body {
      display: none;
      position: fixed;
      inset: 48px 0 0 0;
      background: var(--surface);
      overflow-y: auto;
      padding: var(--s-5) var(--s-4);
    }
    .nav-toggle-checkbox:checked ~ .body { display: flex; }
    .nav-toggle-checkbox:checked ~ .toggle { color: var(--acc); }
    .body a, .disabled { font-size: 14px; }
  }
</style>

<script>
  // Covers every nav item, including "Home" (href="/") and "Contact" (the .foot link) —
  // all of them live inside .body, so a single selector reaches all of them.
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.body a'));
  const toggle = document.getElementById('nav-toggle');
  const idFor = (href: string) => (href === '/' ? 'home' : href.startsWith('/#') ? href.slice(2) : null);

  // A same-page anchor jump doesn't trigger a full reload, so nothing else
  // would close the mobile menu overlay after picking a section — do it here.
  navLinks.forEach((a) => {
    a.addEventListener('click', () => {
      if (toggle instanceof HTMLInputElement) toggle.checked = false;
    });
  });

  // Scroll-spy only applies on the home page, where the sections actually exist.
  // (On a detail page, the server-rendered .active class from Rail.astro's `active()`
  // is left alone — there's nothing here to observe.)
  if (location.pathname === '/') {
    const sections = navLinks
      .map((a) => {
        const id = idFor(a.getAttribute('href') ?? '');
        return id === 'home' ? document.querySelector<HTMLElement>('.boot') : id ? document.getElementById(id) : null;
      })
      .filter((el): el is HTMLElement => el instanceof HTMLElement);

    if (sections.length > 0) {
      const setActive = (id: string) => {
        navLinks.forEach((a) => {
          a.classList.toggle('active', idFor(a.getAttribute('href') ?? '') === id);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((e) => e.isIntersecting);
          if (visible.length > 0) {
            const topMost = visible.reduce((a, b) => (a.boundingClientRect.top < b.boundingClientRect.top ? a : b));
            setActive(topMost.target.id || 'home');
          }
        },
        { rootMargin: '-10% 0px -70% 0px' }
      );
      sections.forEach((s) => observer.observe(s));
    }
  }
</script>
